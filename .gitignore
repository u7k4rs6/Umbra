# Built binaries. These patterns are anchored, because an unanchored
# "entire-umbra" also matches the source directory cmd/entire-umbra/ and
# silently keeps the whole command package out of the repository.
/entire-umbra
/umbra/entire-umbra
/umbra-out/

*.test
*.out

# Python fixture venv
umbra/fixtures/app/.venv/
__pycache__/
*.pyc
.pytest_cache/

# Playwright MCP scratch output
.playwright-mcp/
